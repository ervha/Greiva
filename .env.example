API_HOST=127.0.0.1
API_PORT=3000
COLLABORATION_HOST=127.0.0.1
COLLABORATION_PORT=1234
DATABASE_URL=postgresql://greiva:greiva_dev_only@127.0.0.1:5432/greiva_poc

# Explicit private API commands only; ordinary PoC commands do not use these.
# Set a real project URL and current non-symmetric signing algorithm.
# GREIVA_SUPABASE_URL=https://your-project.supabase.co
# GREIVA_SUPABASE_ALGORITHM=ES256
# GREIVA_PRIVATE_SCHEMA=greiva_private_local
# GREIVA_PRIVATE_HOST=127.0.0.1
# GREIVA_PRIVATE_PORT=3001

# Dedicated /auth.html preview; public settings only, no passwords/tokens.
# VITE_GREIVA_SUPABASE_URL=https://your-project.supabase.co
# VITE_GREIVA_SUPABASE_ALGORITHM=ES256
# VITE_GREIVA_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
# VITE_GREIVA_PRIVATE_API_ORIGIN=http://127.0.0.1:1421
# GREIVA_PRIVATE_PROXY_TARGET=http://127.0.0.1:3001
