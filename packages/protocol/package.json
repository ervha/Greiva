{
  "name": "@greiva/protocol",
  "version": "0.58.0",
  "private": true,
  "type": "module",
  "exports": {
    "./private-database-source": {
      "types": "./dist/private-database-source.d.ts",
      "import": "./dist/private-database-source.js"
    },
    "./private-page-changes": {
      "types": "./dist/private-page-changes.d.ts",
      "import": "./dist/private-page-changes.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js"
    },
    "./private-page": {
      "types": "./dist/private-page.d.ts",
      "import": "./dist/private-page.js"
    },
    "./private-page-metadata": {
      "types": "./dist/private-page-metadata.d.ts",
      "import": "./dist/private-page-metadata.js"
    },
    "./private-page-catalog": {
      "types": "./dist/private-page-catalog.d.ts",
      "import": "./dist/private-page-catalog.js"
    },
    "./private-database-record": {
      "types": "./dist/private-database-record.d.ts",
      "import": "./dist/private-database-record.js"
    },
    "./private-database-record-catalog": {
      "import": "./dist/private-database-record-catalog.js",
      "types": "./dist/private-database-record-catalog.d.ts"
    },
    "./private-database-view": {
      "import": "./dist/private-database-view.js",
      "types": "./dist/private-database-view.d.ts"
    },
    "./private-database-view-catalog": {
      "types": "./dist/private-database-view-catalog.d.ts",
      "import": "./dist/private-database-view-catalog.js"
    },
    "./private-database-changes": {
      "types": "./dist/private-database-changes.d.ts",
      "import": "./dist/private-database-changes.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@greiva/domain": "0.58.0",
    "zod": "4.6.5",
    "@greiva/shared": "0.58.0"
  }
}
