{
  "name": "@greiva/api",
  "private": true,
  "version": "0.46.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "dev:private": "node --env-file-if-exists=../../.env --import tsx src/private-main.ts",
    "start:private": "node --env-file-if-exists=../../.env dist/private-main.js",
    "init:private": "node --env-file-if-exists=../../.env --import tsx src/init-private.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@greiva/application": "0.46.0",
    "@greiva/domain": "0.46.0",
    "@greiva/protocol": "0.46.0",
    "@greiva/shared": "0.46.0",
    "@nestjs/common": "12.1.1",
    "@nestjs/core": "12.1.1",
    "@nestjs/platform-fastify": "12.1.1",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
